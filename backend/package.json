    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "mongodb-memory-server": "^10.1.4"
  }
