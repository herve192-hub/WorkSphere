{
  "name": "worksphere-api",
  "version": "1.0.0",
  "description": "WorkSphere modular-monolith API",
  "main": "server.js",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate:names": "node scripts/migrate-names.js",
    "migrate:employee-numbers": "node scripts/migrate-employee-numbers.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node ../.github/scripts/run-backend-tests.mjs unit",
    "test:integration": "node ../.github/scripts/run-backend-tests.mjs integration",
    "openapi:check": "node scripts/check-openapi.js",
    "check": "find src scripts -type f -name '*.js' -print0 | xargs -0 -n1 node --check && node --check server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.4",
    "swagger-ui-dist": "5.33.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.3.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  }
}
