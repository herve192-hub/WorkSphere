# example environment variables for Worksphere backend
PORT=5000
# Use a replica set for atomic employee/auth changes and audit records.
MONGO_URI=mongodb://127.0.0.1:27017/worksphere?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
# Run npm run audit:worker alongside the API. sync is an explicit rollback mode.
AUDIT_DELIVERY_MODE=async

# Independently runnable private Audit HTTP service; choose its database explicitly.
# Start with npm run audit:service. Keep this listener on a private network.
AUDIT_MONGO_URI=mongodb://127.0.0.1:27017/worksphere_audit?replicaSet=rs0
AUDIT_HOST=127.0.0.1
AUDIT_PORT=5001
# Replace all three placeholders with distinct random secrets (at least 32 bytes).
# These are service credentials, separate from JWT_ACCESS_SECRET and browser tokens.
AUDIT_SERVICE_KEYS={"employees":"replace-with-a-random-employee-service-secret","identity":"replace-with-a-random-identity-service-secret","api":"replace-with-a-random-api-service-secret"}
