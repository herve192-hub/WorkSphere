# example environment variables for Worksphere backend
PORT=5000
# Use a replica set for atomic employee/auth changes and audit records.
MONGO_URI=mongodb://127.0.0.1:27017/worksphere?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
