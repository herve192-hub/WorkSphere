{
  "name": "worksphere-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "dependencies": {
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.1.0",
    "react-modal": "3.16.3",
    "react-router-dom": "7.18.4",
    "web-vitals": "2.1.4"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "npm run lint && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --reporter=junit --outputFile.json=reports/vitest.json --outputFile.junit=reports/junit.xml",
    "test:e2e": "bash ../.github/scripts/verify-containers.sh --browser-tests",
    "test:e2e:run": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.26.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "13.5.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
